# Copy this file to .env and fill in your own values.
# None of these are real — they are placeholders for the demo.

# --- Internal data warehouse client ---
WAREHOUSE_APP_KEY=your_org.your_service.your_app_key
WAREHOUSE_APP_SECRET=change_me
WAREHOUSE_API_BASE=https://warehouse-api.internal.example.com

# --- SFTP (invoice partner exchange) ---
SFTP_HOST=sftp.partner.example.com
SFTP_PORT=22
SFTP_USERNAME=your_sftp_username
# Password is NOT stored here — it's read from the OS keyring at runtime.
# Set it once with: keyring.set_password(SFTP_KEYRING_SERVICE, SFTP_USERNAME, "...")
SFTP_KEYRING_SERVICE=invoicing-sftp-prod
SFTP_REMOTE_OUTGOING_DIR=/outgoing
SFTP_REMOTE_ARCHIVE_DIR=/outgoing/archive
SFTP_REMOTE_INCOMING_DIR=/incoming

# --- Google Sheets (status tracking / mapping sheets) ---
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json
GSHEET_DAILY_REPORT_ID=your_daily_report_sheet_id
GSHEET_TAX_ID_TRACKER_ID=your_tax_id_tracker_sheet_id

# --- Local working directories ---
LOCAL_UPLOAD_DIR=./data/uploads
LOCAL_RESULT_DIR=./data/results
LOCAL_OUTPUT_DIR=./output

# --- Business rules ---
MAX_ROWS_PER_FILE=20000
RECONCILIATION_TOLERANCE=1.0
